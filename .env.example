# Copiar este archivo como .env y completar los valores reales.
# No subir .env al repositorio.
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# Nombre exacto del deployment creado en Azure OpenAI Studio.
AZURE_OPENAI_DEPLOYMENT=
# También se acepta AZURE_OPENAI_MODEL como alias del deployment.

# Gmail de envío de recuperación. La contraseña de aplicación de Gmail se
# configura únicamente en C:\xampp\sendmail\sendmail.ini, nunca en este archivo.
SIGTUR_MAIL_FROM=tu-cuenta@gmail.com
SIGTUR_MAIL_FROM_NAME=SIGTUR

# Opcional: usar un bearer token en lugar de API key.
# AZURE_OPENAI_BEARER_TOKEN=
